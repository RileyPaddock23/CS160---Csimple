Grammar

    0 $accept: Program $end

    1 Program: Procedures

    2 Procedures: Procedures procedure_decleration
    3           | ε

    4 procedure_decleration: PROC ID PARENO parameter_list PARENC RETURN type procedure_block

    5 parameter_list: parameter_decl multi_type
    6               | ε

    7 multi_type: SEMI parameter_decl multi_type
    8           | ε

    9 parameter_decl: id_list COLON non_str_type

   10 id_list: ID COMMA id_list
   11        | ID

   12 non_str_type: BOOL
   13             | CHAR
   14             | INT
   15             | CHARPTR
   16             | INTPTR

   17 type: non_str_type
   18     | string

   19 procedure_block: BRACKO proc_list decl_list stat_list return_stmt BRACKC

   20 proc_list: procedure_decleration proc_list
   21          | ε

   22 return_stmt: RETURN expression SEMI

   23 variable_decleration: VAR id_list COLON type SEMI

   24 string: STR SBRACKO INT_VAL SBRACKC

   25 str_id_lhs: ID SBRACKO expression SBRACKC

   26 str_id_expr: ID SBRACKO expression SBRACKC

   27 statement: assignment
   28          | assignment_val IS ID PARENO expr_list PARENC SEMI
   29          | IF PARENO expression PARENC BRACKO code_block BRACKC
   30          | IF PARENO expression PARENC BRACKO code_block BRACKC ELSE BRACKO code_block BRACKC
   31          | WHILE PARENO expression PARENC BRACKO code_block BRACKC
   32          | BRACKO code_block BRACKC

   33 assignment: assignment_val IS expression SEMI
   34           | assignment_val IS STRING_VAL SEMI

   35 assignment_val: ID
   36               | str_id_lhs
   37               | DEREF ID

   38 expr_list: expression multi_expr
   39          | ε

   40 multi_expr: COMMA expression multi_expr
   41           | ε

   42 primary_expression: PARENO expression PARENC
   43                   | ABS expression ABS
   44                   | ID
   45                   | str_id_expr
   46                   | INT_VAL
   47                   | CHAR_VAL
   48                   | BOOL_VAL
   49                   | KNULL

   50 unary_expression: primary_expression
   51                 | MINUS unary_expression
   52                 | NOT unary_expression
   53                 | ref_expression
   54                 | DEREF primary_expression

   55 ref_expression: REF assignment_val

   56 multiplicative_expression: unary_expression
   57                          | multiplicative_expression TIMES unary_expression
   58                          | multiplicative_expression DIV unary_expression

   59 additive_expression: multiplicative_expression
   60                    | additive_expression PLUS multiplicative_expression
   61                    | additive_expression MINUS multiplicative_expression

   62 relational_expression: additive_expression
   63                      | relational_expression EQ additive_expression
   64                      | relational_expression LT additive_expression
   65                      | relational_expression GT additive_expression
   66                      | relational_expression LEQ additive_expression
   67                      | relational_expression GEQ additive_expression
   68                      | relational_expression NEQ additive_expression

   69 and_expression: relational_expression
   70               | and_expression AND relational_expression

   71 expression: and_expression
   72           | expression OR and_expression

   73 decl_list: variable_decleration decl_list
   74          | ε

   75 stat_list: statement stat_list
   76          | ε

   77 code_block: decl_list stat_list


